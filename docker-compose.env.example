# Copy to `.env` before a real deployment: `cp docker-compose.env.example .env`.
# Every one of these has a working default baked into docker-compose.yml, so the stack
# comes up with none of this set — but the three below are dev-only placeholders and
# must be changed before this holds anyone's real data. See docs/deployment.md.

DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
SESSION_SECRET=

# Optional — defaults are in docker-compose.yml.
# DB_OWNER_USER=sincp
# DB_NAME=sincp
# APP_PORT=127.0.0.1:3000
# SEED=false
# STORAGE_MAX_BYTES=10485760
