# Runtime role — NOT the migration owner. See drizzle/0001_rls.sql.
DATABASE_URL=postgres://sincp_app:sincp_app_dev_only@localhost:5432/sincp
# Owner role, used only by drizzle-kit migrations.
DATABASE_MIGRATION_URL=postgres://sincp:sincp@localhost:5432/sincp
# Cross-tenant role, used ONLY by withoutTenantScope() (login lookup, signup).
# Separate role, not a setting: sincp_app must not be able to grant itself bypass.
DATABASE_ADMIN_URL=postgres://sincp_admin:sincp_admin_dev_only@localhost:5432/sincp

# 32+ random bytes. Rotating this invalidates every session.
SESSION_SECRET=change-me-openssl-rand-base64-32

# Where attachments live. Must be outside the web root.
STORAGE_DIR=./storage
STORAGE_MAX_BYTES=10485760

NODE_ENV=development

# Notifications. Unset means "print to stdout" — never leave it unset in production.
# NOTIFY_TRANSPORT=smtp
# SMTP_HOST=smtp.example.ac.in
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=grievances@example.ac.in
# SMTP_TLS=starttls        # starttls (default) | implicit | off

# AI assist. Unset means the heuristic provider: local, deterministic, no network,
# no model. Every feature still works, slightly worse.
#
# Point AI_BASE_URL at a model running on the institution's own hardware (Ollama,
# vLLM, llama.cpp). Grievance text is redacted before it is sent either way, but
# redaction reduces risk rather than removing it, and under the DPDP Act sending
# student grievances to a third-party endpoint is a decision to take knowingly.
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.1:8b
# AI_API_KEY=
# AI_TIMEOUT_MS=20000

# Autonomous agents. Escalate, notify, record. Nothing else.
# AGENT_INTERVAL_MS=900000
